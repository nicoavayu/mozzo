# Required for admin login and protected admin actions.
ADMIN_PASSWORD=change-me
ADMIN_TOKEN_SECRET=replace-with-a-long-random-secret

# Optional local defaults.
PORT=3000
# Si no lo definís, el backend usa ~/.mozzo/data/database.sqlite
# DATABASE_PATH=/ruta/estable/database.sqlite
UPLOAD_DIR=./uploads
FRONTEND_URL=http://localhost:5173
PYTHON_BIN=./venv/bin/python3
PROCESS_MENU_SCRIPT=./process_menu.py
GUEST_FEEDBACK_URL=
GUEST_REVIEW_URL=
